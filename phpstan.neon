parameters:
    level: 5
    phpVersion: 70200
    tmpDir: /tmp/phpstan/ForceSSL/main
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - tests/*
    bootstrapFiles:
        - ../../bootstrap-phpstan.php
    universalObjectCratesClasses:
        - Piwik\Config
        - Piwik\View
        - Piwik\ViewDataTable\Config
    scanDirectories:
        - ../../
